# Google Gemini API Key for server-side product intelligence and editorial analysis
GEMINI_API_KEY=

# Server Port (default 3000)
PORT=3000

# Node environment (development or production)
NODE_ENV=development

# Optional Cloudflare Worker API URL (defaults to https://product-studio-api.scienceofgifts.workers.dev in production)
VITE_WORKER_API_URL=https://product-studio-api.scienceofgifts.workers.dev

