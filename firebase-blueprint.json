{
  "entities": {
    "EditorialRules": {
      "title": "EditorialRules",
      "description": "User global canonical editorial rules and instructions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rules": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "BusinessBrain": {
      "title": "BusinessBrain",
      "description": "Legacy user brand identity and business brain settings (for backwards compatibility migration)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "businessName": { "type": "string" },
        "brandValues": { "type": "string" },
        "targetAudience": { "type": "string" },
        "positioningStatement": { "type": "string" },
        "brandVoice": { "type": "string" },
        "defaultInstructions": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "WritingGuidelines": {
      "title": "WritingGuidelines",
      "description": "Legacy user writing style guidelines and rules (for backwards compatibility migration)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "voiceAndTone": { "type": "string" },
        "doRules": { "type": "string" },
        "dontRules": { "type": "string" },
        "formattingRules": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "ApprovedWritingExample": {
      "title": "ApprovedWritingExample",
      "description": "User approved writing style examples",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "deleted": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/users/{userId}/settings/editorial_rules": {
      "schema": "EditorialRules",
      "description": "User canonical editorial rules document"
    },
    "/users/{userId}/settings/business_brain": {
      "schema": "BusinessBrain",
      "description": "Legacy user business brain settings document"
    },
    "/users/{userId}/settings/writing_guidelines": {
      "schema": "WritingGuidelines",
      "description": "Legacy user writing guidelines document"
    },
    "/users/{userId}/writing_examples/{exampleId}": {
      "schema": "ApprovedWritingExample",
      "description": "User approved writing examples collection"
    }
  }
}
